# SANAD compose environment — documents EVERY variable (§4).
# Copy to .env (gitignored). Real secrets belong in secrets/*.sops.yaml, never here.

# ── mode ────────────────────────────────────────────────
# dev | sovereign | edge — one env var rules them all (§4)
SANAD_MODE=dev

# ── postgres ────────────────────────────────────────────
POSTGRES_USER=sanad
POSTGRES_PASSWORD=sanad
POSTGRES_DB=sanad

# ── minio (model registry + mlflow artifacts + tfstate) ─
MINIO_ROOT_USER=sanad
MINIO_ROOT_PASSWORD=sanad-secret

# ── api ─────────────────────────────────────────────────
# bearer token for machine ingestion (eval-job → /v1/eval/runs/{id}/ingest)
SANAD_SERVICE_TOKEN=dev-token
# dev-only: persist chat content for debugging (ALWAYS off outside dev)
SANAD_PERSIST_CHATS=false

# ── model volumes (gpu / edge profiles) ─────────────────
# host dir mirrored from s3://sanad-models — mounted read-only into vllm/llamacpp
SANAD_MODELS_DIR=./models

# ── observability ───────────────────────────────────────
GRAFANA_PASSWORD=sanad

# ── langfuse (profile: trace) ───────────────────────────
LANGFUSE_SECRET=dev-secret-change-me
LANGFUSE_SALT=dev-salt-change-me

# ── training cost logging (ml/train/sft.py) ─────────────
SANAD_GPU_USD_HR=0.60
