[Unit]
Description=SANAD tegrastats → Prometheus exporter
After=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
ExecStart=/usr/bin/python3 /usr/local/bin/tegrastats_exporter.py --port {{ exporter_port }} --source {{ inventory_hostname }}
Environment=SANAD_API_URL={{ api_url }}
Environment=LLAMA_METRICS_URL=http://127.0.0.1:8080/metrics

[Install]
WantedBy=multi-user.target
