[Unit]
Description=SANAD llama-server (GGUF Q4_K_M edge inference)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=5
TimeoutStartSec=180
ExecStartPre=-/usr/bin/docker rm -f sanad-llama
ExecStart=/usr/bin/docker run --name sanad-llama --rm \
    --runtime nvidia --network host \
    -v {{ models_dir }}:/models:ro \
    -e SANAD_GGUF_PATH=/models/{{ gguf_file }} \
    -e SANAD_CTX={{ llama_ctx }} \
    -e SANAD_PARALLEL={{ llama_parallel }} \
    {{ llamacpp_image }}
ExecStop=/usr/bin/docker stop sanad-llama
MemoryMax={{ llama_memory_max }}

[Install]
WantedBy=multi-user.target
