# Jetson Orin edge server — llama.cpp llama-server with CUDA, built inside the
# jetson-containers base (L4T r36 / JetPack 6.x) (§6.2). Pin the llama.cpp commit here and
# bump ONLY together with a re-run of `just bench-jetson` + ppl-gate.
ARG L4T_BASE=dustynv/l4t-pytorch:r36.4.0
FROM ${L4T_BASE} AS build

ARG LLAMA_CPP_REV=<pin-llamacpp-commit-sha>

RUN apt-get update && apt-get install -y --no-install-recommends \
        git cmake build-essential libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN git clone https://github.com/ggml-org/llama.cpp && \
    cd llama.cpp && git checkout "${LLAMA_CPP_REV}"

RUN cmake -S llama.cpp -B llama.cpp/build \
        -DGGML_CUDA=1 \
        -DCMAKE_CUDA_ARCHITECTURES="87" \
        -DLLAMA_CURL=ON && \
    cmake --build llama.cpp/build --target llama-server -j"$(nproc)"

FROM ${L4T_BASE}
COPY --from=build /opt/llama.cpp/build/bin/llama-server /usr/local/bin/llama-server
COPY run.sh /usr/local/bin/run-llama.sh
RUN chmod +x /usr/local/bin/run-llama.sh && useradd -u 10001 -m llama
USER 10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/run-llama.sh"]
