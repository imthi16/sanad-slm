{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanad.local/schemas/record.schema.json",
  "title": "SANAD SFT/eval record",
  "type": "object",
  "required": ["id", "messages", "lang", "domain", "provenance", "source", "pii_checked", "split"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]{6}$",
      "description": "e.g. bank-ar-000142"
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "additionalProperties": false,
        "properties": {
          "role": { "enum": ["system", "user", "assistant"] },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },
    "lang": { "enum": ["ar", "en", "mixed"] },
    "domain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "banking.compliance",
          "banking.retail",
          "banking.corporate",
          "banking.islamic",
          "general"
        ]
      }
    },
    "provenance": { "enum": ["native", "translated", "synthetic"] },
    "source": {
      "type": "object",
      "required": ["name", "license"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "license": { "type": "string" },
        "citation": { "type": "string" },
        "reviewer": { "type": "string", "description": "reviewer initials for own-authored pairs" }
      }
    },
    "pii_checked": { "type": "boolean" },
    "split": { "enum": ["train", "val", "test"] },
    "eval": {
      "type": "object",
      "description": "present on eval-set items only (evals/domain/*)",
      "required": ["task"],
      "additionalProperties": false,
      "properties": {
        "task": { "enum": ["extraction", "classification", "grounded_qa"] },
        "answer": { "type": "string" },
        "choices": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "grounding": { "type": "string" }
      }
    }
  }
}
