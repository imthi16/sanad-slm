# ── secrets / env ──────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/**
!secrets/*.sops.yaml
!secrets/README.md

# ── python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# ── node / web ─────────────────────────────────────────
node_modules/
apps/web/dist/
apps/web/dev-dist/
apps/web/playwright-report/
apps/web/test-results/
